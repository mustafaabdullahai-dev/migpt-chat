APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ---- LLM ----
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Python analysis sandbox ----
# docker (default) = isolated container (network none, memory/cpu/pids caps, non-root).
# restricted = RestrictedPython in a subprocess + rlimits + import whitelist.
# disabled = tool refuses to run. The tool auto-disables if no sandbox is available.
ENABLE_PYTHON_ANALYSIS=true
PYTHON_SANDBOX=docker

# ---- Storage ----
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# ---- Search ----
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Google Custom Search JSON API (official; needs BOTH key + cx). Auto-selected when both set.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
MAX_SEARCH_RESULTS=8
MAX_PAGE_SIZE=200000

# ---- Features ----
ENABLE_WEB_SEARCH=true
ENABLE_ARXIV=true
ENABLE_WIKIPEDIA=true
ENABLE_CALCULATOR=true
ENABLE_DOCUMENT_RAG=true
ENABLE_FOLLOWUPS=true
ENABLE_CLAIM_VERIFICATION=true
ENABLE_CACHE=true

# ---- Research (depth tiers: quick 1-3, standard 3-6, deep = decomposition + loops) ----
DEFAULT_MODE=auto
RESEARCH_QUICK_MAX_ITERATIONS=1
RESEARCH_QUICK_MAX_SOURCES=3
RESEARCH_QUICK_MAX_SEARCHES=3
RESEARCH_STANDARD_MAX_SEARCHES=6
RESEARCH_DEEP_MAX_ITERATIONS=3
RESEARCH_DEEP_MAX_SOURCES=8
RESEARCH_DEEP_FIRST_QUERIES=4
RESEARCH_DEEP_FOLLOWUP_QUERIES=3
RESEARCH_MAX_ITERATIONS=2
RESEARCH_MAX_SOURCES=6

# ---- Security ----
SECRET_KEY=

# ---- Demo (no external APIs required) ----
DEMO_MODE=false

# ---- Document RAG (optional reranking stage) ----
ENABLE_RERANKING=true
RERANK_MODE=hybrid   # none | hybrid (offline lexical+cosine blend)